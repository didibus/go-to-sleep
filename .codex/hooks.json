{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=$(git rev-parse --show-toplevel) && python3 \"$repo_root/.claude/skills/spec-driven/scripts/rfc.py\" hook",
            "timeout": 10,
            "statusMessage": "Checking RFC allocation..."
          }
        ]
      }
    ]
  }
}
