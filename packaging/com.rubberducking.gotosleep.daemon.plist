<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>          <string>com.rubberducking.gotosleep.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Application Support/GoToSleep/bin/gotosleepd</string>
  </array>
  <key>RunAtLoad</key>      <true/>
  <key>KeepAlive</key>      <true/>
  <key>ThrottleInterval</key> <integer>1</integer>
  <key>StandardOutPath</key> <string>/Library/Logs/GoToSleep/gotosleepd.stderr.log</string>
  <key>StandardErrorPath</key> <string>/Library/Logs/GoToSleep/gotosleepd.stderr.log</string>
</dict>
</plist>
